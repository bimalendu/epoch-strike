{
  "name": "epoch-strike",
  "version": "0.1.0",
  "description": "Epoch Strike - a single-player 2D run-and-gun across 20 eras of Earth. Plain HTML/CSS/JS, zero dependencies.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=99 --test-coverage-branches=94 --test-coverage-functions=98 \"tests/**/*.test.js\"",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "shots": "node tools/shots.mjs",
    "parity": "node tools/parity.mjs",
    "levelshots": "node tools/levelshots.mjs",
    "themeshots": "node tools/themeshots.mjs",
    "bossshots": "node tools/bossshots.mjs",
    "musicwav": "node tools/musicwav.mjs",
    "perf": "node tools/perf.mjs",
    "economy": "node tools/economy.mjs",
    "mutate": "stryker run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1"
  }
}
