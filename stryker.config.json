{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "node --test tests/unit/*.test.js" },
  "coverageAnalysis": "off",
  "mutate": [
    "src/game/{save,run,score,lives,progress,camera,weapons,swing,tesla,stealth}.js",
    "src/engine/{rng,font}.js"
  ],
  "ignorePatterns": ["docs", "reports", "test-results", "playwright-report", "tests/e2e", "tests/integration"],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "thresholds": { "high": 90, "low": 80, "break": null },
  "timeoutMS": 30000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
